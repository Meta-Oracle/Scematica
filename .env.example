# ============================================================
# Scematica Bot Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- RPC ---
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
RPC_WEBSOCKET_ENDPOINT=wss://api.mainnet-beta.solana.com
COMMITMENT_LEVEL=confirmed

# --- Wallet ---
# Path to your Solana keypair JSON file
KEYPAIR_PATH=~/.config/solana/id.json
# OR: base58-encoded private key (less secure)
# KEYPAIR_PATH=<base58_private_key>

# --- Execution ---
# Options: default | jito
EXECUTOR=default
JITO_URL=https://mainnet.block-engine.jito.wtf

# --- On-chain program ---
# Deployed address of the scematica-swap program
SWAP_PROGRAM_ID=ScemSwap1111111111111111111111111111111111

# --- Logging ---
RUST_LOG=info
