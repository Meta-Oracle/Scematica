# ============================================================
# Scematica Bot Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- RPC ---
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
RPC_WEBSOCKET_ENDPOINT=wss://api.mainnet-beta.solana.com
COMMITMENT_LEVEL=confirmed

# --- Wallet ---
# Path to your Solana keypair JSON file
KEYPAIR_PATH=~/.config/solana/id.json
# OR: base58-encoded private key (less secure)
# KEYPAIR_PATH=<base58_private_key>

# --- Execution ---
# Options: default | jito
EXECUTOR=default
JITO_URL=https://mainnet.block-engine.jito.wtf

# --- On-chain program ---
# Deployed address of the scematica-swap program
SWAP_PROGRAM_ID=ScemSwap1111111111111111111111111111111111

# --- Logging ---
RUST_LOG=info

# ============================================================
# AI Layer (optional but recommended)
# ============================================================

# Groq — FREE, no credit card, 14,400 req/day, ultra-fast
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter — fallback, 50 free req/day, 200+ models
# Get your key at: https://openrouter.ai
# OPENROUTER_API_KEY=your_openrouter_key_here

# Override the AI model (optional — defaults to llama-3.3-70b-versatile on Groq)
# AI_MODEL=llama-3.3-70b-versatile

# If neither key is set, the AI layer is disabled and the bot runs without it.
