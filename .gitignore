# ── Build artifacts ──────────────────────────────────────────────────────────
/target
target/
debug/
release/
*.pdb

# ── Secrets / environment ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.json.key
# npm auth tokens — never commit a repo-local .npmrc containing _authToken.
# The real token lives in the global user config (~/.npmrc), outside the repo.
.npmrc
**/.npmrc
# Never commit wallet or program keypairs from target/deploy
programs/*/target/
# Live bot config — contains your RPC api-key and keypair path. Use
# config.example.toml as the tracked template; keep your real config.toml local.
/config.toml

# ── Runtime IPC and state files (written/rewritten on every session) ──────────
# These are file-based IPC between sniper and dashboard processes.
# They must not be tracked — they change on every run and contain no source history.
scematica-*.json
scematica-*.jsonl
pool-cache.json
# Agent-playground runtime state (regenerated each run)
playground.json
agent-playground/playground.json

# ── Operational config (may contain live addresses / paths) ───────────────────
snipe-list.txt

# ── Log files ─────────────────────────────────────────────────────────────────
*.log

# ── Process lock files ────────────────────────────────────────────────────────
scematica-*.lock

# ── Backup files (auto-created by filter-stats / reputation rollover) ─────────
*.bak-*
*.bak

# ── JSONL backups (trade history backups, not the live append-only log) ───────
*.jsonl.bak-*

# ── Claude Code internal directories ──────────────────────────────────────────
.claude/

# ── IDE / tool directories ────────────────────────────────────────────────────
.kiro/
.grok/
.vscode/
.idea/
*.iml

# ── Shell / test scripts not needed in repo ───────────────────────────────────
stress_test.sh
*.sh

# ── OS-generated files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Web app build artifacts ───────────────────────────────────────────────────
web/.next/
web/node_modules/
web/.env.local
web/out/
*.tsbuildinfo

# ── Mobile (Capacitor / Android) build outputs + signing secrets ──────────────
web/android/.gradle/
web/android/build/
web/android/app/build/
web/android/local.properties
web/android/keystore.properties
web/android/app/src/main/assets/public/
web/android/app/google-services.json
*.jks
*.keystore
*.apk
*.aab
web/android/dapp-store/media/*.png
web/android/dapp-store/media/*.jpg
web/public/scematica*.apk

# ── Session-artifact docs (Claude-generated per-session reports, not source truth) ──
ANALYSIS_REPORT.md
BUILD_STATUS.md
DEPLOY_CHECKLIST.md
FIX_VERIFICATION.md
OPTIMIZATION_COMPLETE.md
OPTIMIZATION_REPORT.md
PHASE1_OPTIMIZATION.md
POOL_EVALUATION_FIX.md
README_FIXES.md
READY_TO_DEPLOY.md
SETUP_SUMMARY.md
SPIKE_ROOT_CAUSE.md
LIVE_DATA_REPORT.md
scematica_analysis.md

# ── Backup / alternate config files (not source of truth) ─────────────────────
config-*.toml

# ── Python build / dist artifacts ───────────────────────────────────────────
alchem-link/dist/
alchem-link/build/
alchem-link/src/*.egg-info/
alchem-link/.eggs/
*.tar.gz
*.whl

# ── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/

# ── Misc ──────────────────────────────────────────────────────────────────────
tweets.md

# Arb pool graph — runtime data, regenerated by `cargo run -p pool-seeder`
pools/

# Rendered NFT output — regenerate with `scema nft`, never a source of truth.
nft-out/

# Scema-World $SCEMA claim ledger. Machine-local, and the one file in the repo whose
# contents are load-bearing for money: it holds every wallet's lifetime withdrawal total
# and the deployment's cumulative payout, so committing one deployment's ledger would
# hand another deployment somebody else's caps. `SCEMAWORLD_LEDGER` moves it somewhere
# with its own backups, which is what a production deployment should do.
.scemaworld-claims.json
.scemaworld-claims.json.tmp
.aider*
