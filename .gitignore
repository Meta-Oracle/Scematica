# ── Build artifacts ──────────────────────────────────────────────────────────
/target
target/
debug/
release/
*.pdb

# ── Secrets / environment ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.json.key
# Never commit wallet or program keypairs from target/deploy
programs/*/target/

# ── Runtime IPC and state files (written/rewritten on every session) ──────────
# These are file-based IPC between sniper and dashboard processes.
# They must not be tracked — they change on every run and contain no source history.
scematica-*.json
scematica-*.jsonl
pool-cache.json
# Agent-playground runtime state (regenerated each run)
playground.json
agent-playground/playground.json

# ── Operational config (may contain live addresses / paths) ───────────────────
snipe-list.txt

# ── Log files ─────────────────────────────────────────────────────────────────
*.log

# ── Process lock files ────────────────────────────────────────────────────────
scematica-*.lock

# ── Backup files (auto-created by filter-stats / reputation rollover) ─────────
*.bak-*
*.bak

# ── JSONL backups (trade history backups, not the live append-only log) ───────
*.jsonl.bak-*

# ── Claude Code internal directories ──────────────────────────────────────────
.claude/

# ── IDE / tool directories ────────────────────────────────────────────────────
.kiro/
.vscode/
.idea/
*.iml

# ── Shell / test scripts not needed in repo ───────────────────────────────────
stress_test.sh
*.sh

# ── OS-generated files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Web app build artifacts ───────────────────────────────────────────────────
web/.next/
web/node_modules/
web/.env.local
web/out/

# ── Session-artifact docs (Claude-generated per-session reports, not source truth) ──
ANALYSIS_REPORT.md
BUILD_STATUS.md
DEPLOY_CHECKLIST.md
FIX_VERIFICATION.md
OPTIMIZATION_COMPLETE.md
OPTIMIZATION_REPORT.md
PHASE1_OPTIMIZATION.md
POOL_EVALUATION_FIX.md
README_FIXES.md
READY_TO_DEPLOY.md
SETUP_SUMMARY.md
SPIKE_ROOT_CAUSE.md
LIVE_DATA_REPORT.md
scematica_analysis.md

# ── Backup / alternate config files (not source of truth) ─────────────────────
config-*.toml

# ── Misc ──────────────────────────────────────────────────────────────────────
tweets.md
