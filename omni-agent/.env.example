# Scematica Omni-Agent configuration. Copy to .env and fill in what you have.
# The agent starts with none of these set; it just runs degraded and says so.
# Check what is actually working at any time with:  npx tsx src/cli.ts doctor
#
# This directory has its own .env. The repository root has one too, for the Rust
# bot; neither reads the other. SCEMA_TG_TOKEN below is the one variable that
# means the same thing in both — see the telegram section.

# ---------------------------------------------------------------- required
# xAI key. Without it the agent cannot speak or perceive.
# Get one at https://console.x.ai
XAI_API_KEY=xai-...
# GROK_API_KEY is accepted as an alias if you already have it set.

GROK_MODEL=grok-4.6
# GROK_SMALL_MODEL=grok-4.6          # cheaper model for routine calls
# GROK_TEMPERATURE=0.8
# GROK_MAX_TOKENS=2048
# GROK_TIMEOUT_MS=120000             # live search is legitimately slow

# ------------------------------------------------------------------ cortex
# The Python neural sidecar. Start it with: npm run cortex
SCEMA_CORTEX_URL=http://127.0.0.1:7077
# SCEMA_CORTEX_REQUIRED=false        # true = refuse to boot without it

# Embeddings: auto -> local sentence-transformers, then OpenAI, then hashing.
# SCEMA_EMBED_BACKEND=auto
# SCEMA_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# SCEMA_DEVICE=auto                  # auto | cuda | cpu

# Online training cadence. Defaults are tuned for sparse human feedback.
# SCEMA_LR=3e-4
# SCEMA_BATCH_SIZE=32
# SCEMA_TRAIN_EVERY=8                # feedback events per automatic train step
# SCEMA_REPLAY_CAPACITY=20000

# Retrieval kernel: mojo | numpy | torch. Leave unset to auto-select.
# Measure before overriding:  npm run cortex:bench
# SCEMA_KERNEL=numpy

# ---------------------------------------------------------------- telegram
# The operator cockpit: approve, edit or reject drafts inline.
#
# ONE BOT, ONE POLLER. Telegram's getUpdates hands each update to exactly one
# caller, so two processes on one token do not both see your commands -- they
# split them at random, silently, and one of the two is a bot that can sell
# positions. Hence three separate variables rather than one:
#
#   SCEMA_AGENT_TG_TOKEN   this cockpit's own bot           (preferred)
#   SCEMA_TG_TOKEN         the Rust sniper bot, scema-tgbot (shared fallback)
#   TELEGRAM_BOT_TOKEN     a third bot, for ordinary conversation
#
# Create each with @BotFather. If only SCEMA_TG_TOKEN is set, the cockpit reads
# it but will NOT poll -- that would take commands away from the sniper bot.
SCEMA_AGENT_TG_TOKEN=
# SCEMA_TG_TOKEN=
# SCEMA_AGENT_TG_POLL=1              # poll the sniper's bot anyway (it must be stopped)
# TELEGRAM_BOT_TOKEN=                # a separate bot for conversational Telegram

# Only this chat can approve anything. Without it the cockpit is read-only,
# because an unrestricted approval channel is an open door to your X account.
# Message your bot, then run `npx tsx src/cli.ts doctor` -- it will tell you
# your chat id.
SCEMA_TG_OPERATOR_CHAT_ID=

# --------------------------------------------------------------- bot state
# The sniper's working directory -- where it writes scematica-metrics.json and
# friends. Read-only: the agent reads these files to answer questions about the
# live bot, and never writes to them. Leave unset and the agent will say it
# cannot see the bot rather than guessing at its numbers.
# SCEMA_BOT_DIR=C:\Users\you\scematica

# ----------------------------------------------------------------- x / api
# Official X API credentials (developer.x.com). The modern plugin-twitter uses
# OAuth 1.0a, NOT username/password -- scraper-era logins will not work.
# Free tier allows roughly 17 posts/day; Basic is $200/mo.
TWITTER_API_KEY=
TWITTER_API_SECRET_KEY=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_USERNAME=

# Dry run is the default. Nothing reaches X while this is true, and it stays
# forced true while the four credentials above are missing. Drafts are written
# to data/queue/dry-run-posts.md for review instead.
SCEMA_DRY_RUN=true

# ------------------------------------------------------------- sense loop
SCEMA_SENSE_ENABLED=true
SCEMA_SENSE_INTERVAL_MINUTES=30
SCEMA_SENSE_TOPICS=Solana MEV and transaction landing,memecoin launch mechanics,agentic trading infrastructure,onchain data quality and oracle staleness
# SCEMA_SENSE_MAX_CANDIDATES=25
# SCEMA_SENSE_MAX_DRAFTS=3
# SCEMA_SENSE_MIN_PRIORITY=0.35

# Autonomy is earned, not configured. Leave above 1.0 to always ask first.
# Setting it to e.g. 0.9 lets the agent post unprompted when the taste head
# is at least 90% confident you would approve -- but only after it has seen
# SCEMA_SENSE_AUTOPOST_MIN_EVENTS real decisions from you.
# SCEMA_SENSE_AUTOPOST_TASTE=1.01
# SCEMA_SENSE_AUTOPOST_MIN_EVENTS=200
