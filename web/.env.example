# URL of the Rust API server (scematica-api binary).
# Server-side only — NOT prefixed with NEXT_PUBLIC.
# Set this in Vercel → Settings → Environment Variables.
# For local dev the default is http://localhost:3001
RUST_API_URL=http://localhost:3001

# Optional: Solana RPC endpoint used by the Phantom wallet adapter (browser-side).
# NEXT_PUBLIC_* is inlined into the client bundle at build time, so this value is served
# to every visitor — use a key with a domain allowlist, and not the one the bot uses.
NEXT_PUBLIC_RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# ── Escrow Market (/escrow) ───────────────────────────────────────────────────
# The deployed `scemadex-vault` program. Until this is set, /api/escrow/vault returns
# 503 `not_configured` and the page says "Not deployed" — which is the intended
# behaviour, not a bug. It is deliberately NOT defaulted to the placeholder in the Rust
# source: a placeholder derives real-looking PDAs and would render a page of confident
# "vault not found" rows for addresses that could never hold anything.
# Get this from `solana address -k target/deploy/scemadex_vault-keypair.json`.
# See programs/scemadex-vault/DEPLOY.md.
NEXT_PUBLIC_ESCROW_PROGRAM_ID=

# Solana RPC for the escrow proof-of-reserve reads. **Server-side only** — no
# NEXT_PUBLIC prefix, so unlike the wallet endpoint above this one is never served to
# visitors and may safely carry a real key.
#
# Falls back to a public node when unset. That fallback works, but it is rate-limited
# and slow (~1.3s per call, measured 2026-08-13), so a keyed provider is worth setting
# before pointing anyone at the page. The route reports which host answered and whether
# it was authenticated, so a silent fallback is visible rather than mysterious.
RPC_ENDPOINT=

# Escrow-only RPC override. Takes precedence over RPC_ENDPOINT for /escrow reads and is
# ignored everywhere else.
#
# Exists because the vault program has its own deploy lifecycle — devnet first, mainnet
# once funded (programs/scematica-vault/DEPLOY.md §3) — and without this the only way to
# read a devnet vault is to move the whole site to devnet, market board included.
#
# WARNING: this lets /escrow read a different cluster than the rest of the site. A devnet
# vault holds tokens minted out of nothing and renders identically to a mainnet vault
# holding real reserve; the only thing telling them apart today is the `rpc.host` field on
# the response. Leave it unset unless you are testing, and never demo a devnet vault
# publicly without saying so.
ESCROW_RPC_ENDPOINT=

# ── Scylar terminal ───────────────────────────────────────────────────────────
# LLM provider. Server-side only. First one with a key wins; Groq is fastest, which
# matters because the avatar's mouth is driven by tokens arriving.
GROQ_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=

# ── Scylar portrait generation (optional) ─────────────────────────────────────
# Off unless SCYLAR_IMAGEGEN=1. Off is the correct default: the three sprites are the
# product, and an unconfigured deploy is fully functional rather than degraded.
# SCYLAR_IMAGEGEN=1

# ComfyUI host. The only backend with a transport implemented, and the only one where
# "free" stays true past a few hundred images. Needs the IPAdapter nodes:
#   comfy node install comfyui_ipadapter_plus
# SCYLAR_COMFYUI_URL=http://127.0.0.1:8188

# Checkpoint filename as it appears in ComfyUI's models/checkpoints directory. Overridable
# because a hardcoded name produces ComfyUI's least helpful error ("value not in list") on
# any install that chose a different model.
# SCYLAR_COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors

# IPAdapter preset — resolves both the adapter weights and the CLIP vision encoder.
# SCYLAR_COMFYUI_PRESET=PLUS (high strength)

# How strongly the reference sprite dominates the generation. High on purpose: the point
# of this backend is that her face stays hers. Lower it only if generations stop
# responding to the requested mood.
# SCYLAR_COMFYUI_WEIGHT=0.85

# ── Scema-World $SCEMA treasury (/scema-world → withdraw) ─────────────────────
#
# THE ONE THAT BITES: a deployment with none of these set can read the treasury, quote a
# withdrawal exactly, and refuse to pay it — 501 `not_configured`, and the panel says so.
# That is a supported state, not a bug. What is NOT obvious is that a signer configured as
# a FILE PATH is machine-local: a `.env.local` inherited from a developer's box names a key
# that exists on exactly one computer, so the deployment is unconfigured while the checkout
# works perfectly. `GET /api/scemaworld/treasury` now returns `signer.reason` naming which
# of the four states it is in (`absent` / `key_unreadable` / `key_malformed` /
# `signer_mismatch`), and the withdraw panel prints it.
#
# The signing key. Base58 (what a wallet exports) or a JSON byte array (what solana-keygen
# writes). Server-side only — never NEXT_PUBLIC. **Use this on any deployment.**
SCEMAWORLD_TREASURY_SECRET=
# A path to the same thing, preferred on a local machine so the secret lives in a file with
# its own ACL rather than in an environment block half your tools print. Takes precedence
# over the secret above. Useless on a serverless host.
SCEMAWORLD_TREASURY_KEYFILE=

# The mint and the wallet that pays. Both default to the real $SCEMA mint and treasury in
# `lib/scemaworld/claim.ts`; set them to point at a devnet pair for testing.
SCEMAWORLD_MINT=
SCEMAWORLD_TREASURY=

# RPC for the treasury reads and the payout. Falls back to RPC_ENDPOINT, then to a public
# node. The public node works for the *balance* (it is decoded from a plain getAccountInfo
# precisely so it does), but a keyed endpoint is worth having before anyone claims.
SCEMAWORLD_RPC_ENDPOINT=

# Where the claim ledger lives. Default: `.scemaworld-claims.json` in the working directory.
#
# **This is the decision that has to be made before a public deploy.** The file ledger is
# designed for one process on one disk, and it is correct there — an in-process mutex, an
# `open(..., 'wx')` lock file, and a version check that turns a lost write into a refused
# claim. On a serverless host the filesystem is read-only except /tmp, so every claim fails
# closed with `ledger_unreadable` (safe, and the faucet does not work); point this at /tmp
# and it writes, but each instance gets its own ledger and the budget is multiplied by the
# instance count. Self-host the standalone server, or replace the store.
SCEMAWORLD_LEDGER=

# The caps, all optional, all overriding `DEFAULT_POLICY`. A malformed or negative value
# falls back to the default rather than being coerced — `Number('')` is 0, and a budget
# silently read as zero takes the faucet offline in a way that looks like a chain problem.
#
# THEY MOVE TOGETHER. `entitlement` applies every bound at once with a `Math.min`, so the
# lowest is the only one that ever does anything: a per-claim cap above the per-wallet cap
# can never bind, and a per-wallet cap above the budget can never bind either. Setting one
# in isolation produces a number that is printed, quoted in refusals, and has no effect on
# any payment. `check:scemaworld` asserts the ordering on the defaults.
SCEMAWORLD_CLAIM_RATE=          # whole $SCEMA per in-game SCEMA (default 1)
SCEMAWORLD_CLAIM_MAX=           # most one claim may pay (default 1000000)
SCEMAWORLD_WALLET_MAX=          # most one wallet may ever be paid (default 1000000)
SCEMAWORLD_TREASURY_BUDGET=     # most this deployment will ever pay out (default 1000000)
SCEMAWORLD_CLAIM_COOLDOWN_MS=   # between claims from one wallet (default 21600000 = 6h)
SCEMAWORLD_CLAIM_MIN=           # smallest claim worth a transaction (default 10)
