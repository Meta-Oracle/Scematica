{
  "compilerOptions": {
    // ES2020 for BigInt literals: `lib/alchem/abi.ts` decodes int256 aggregator answers,
    // which do not fit a double. Typecheck-only — `noEmit` is on and Next compiles with
    // SWC against its own browser targets, so this changes no shipped output.
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // Lets a module import a sibling as "./x.ts". Needed because `lib/omni/verify.ts`
    // imports `lib/omni/canonical.ts`, and `npm run check:omni` runs those files directly
    // under Node's native type-stripping loader, which resolves real paths and therefore
    // requires the extension. Safe here: `noEmit` is on, so nothing is written that could
    // carry a `.ts` specifier into shipped output, and this only permits a form that was
    // previously an error.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
